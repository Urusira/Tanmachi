  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435:\nW,
    A, S, D - \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435\n\u041C\u044B\u0448\u044C
    - \u041E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C\u0441\u044F\n\u041F\u0440\u043E\u0431\u0435\u043B
    - \u041F\u0440\u044B\u0436\u043E\u043A\n\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F:\n\u041B\u041A\u041C
    - \u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C\nF - \u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\n\n\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C:\n1-9
    (\u0438\u043B\u0438 \u043A\u043E\u043B\u0451\u0441\u0438\u043A\u043E \u043C\u044B\u0448\u0438)
    - \u0412\u044B\u0431\u043E\u0440 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
    \nE - \u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\nQ
    - \u0412\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442,
    \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0432 \u0445\u043E\u0442\u0431\u0430\u0440\u0435\n\n\u0412\u044B\u0445\u043E\u0434:\nEscape
    - \u0412\u044B\u0445\u043E\u0434 \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435
    \u043C\u0435\u043D\u044E\n\n\n\u0412 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435:\nShift
    (\u0443\u0434\u0435\u0440\u0436.) + \u041B\u041A\u041C - \u0431\u044B\u0441\u0442\u0440\u044B\u0439
    \u043F\u0435\u0440\u0435\u0431\u0440\u043E\u0441 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\n\u041F\u041A\u041C
    - \u0432\u0437\u044F\u0442\u044C \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
    \u0441\u0442\u043E\u043F\u043A\u0438\n\u041B\u041A\u041C - \u0432\u0437\u044F\u0442\u044C
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\n\n\u0410\u0434\u043C\u0438\u043D\u0441\u043A\u0438\u0435:\nF
    \u0431\u0435\u0437 \u0446\u0435\u043B\u0438 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    - \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442"
