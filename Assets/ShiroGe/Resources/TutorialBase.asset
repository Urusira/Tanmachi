  tutorialDatabase:
  - key: Movement
    title: "\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435"
    value: "\u041C\u044B\u0448\u044C - \u041E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C\u0441\u044F\\nWASD
      - \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435\\n\u041F\u0440\u043E\u0431\u0435\u043B
      - \u041F\u0440\u044B\u0436\u043E\u043A\\nShift - \u0421\u043F\u0440\u0438\u043D\u0442\\nX
      - \u0428\u0430\u0433"
    isShowed: 1
    showingTime: 5
  - key: Actions
    title: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F"
    value: "F - \u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\\n\u041B\u041A\u041C
      - \u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C (WIP)\\nE - \u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\\nB
      - \u0420\u0435\u0436\u0438\u043C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\\nQ
      - \u0412\u044B\u043A\u0438\u043D\u0443\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442"
    isShowed: 1
    showingTime: 5
  - key: BuildingMode
    title: "\u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E"
    value: "\u0412\u044B \u0432 \u0440\u0435\u0436\u0438\u043C\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.
      \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0432 \u043F\u0430\u043D\u0435\u043B\u0438
      \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u0430
      \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u043C\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u0441\u0442\u043E\u043B\u0438\u043A)
      \u0438 \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0435\u0433\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C.\\n\u0417\u0430\u0436\u043C\u0438\u0442\u0435
      \u043A\u043B\u0430\u0432\u0438\u0448\u0443 R \u0438 \u043A\u0440\u0443\u0442\u0438\u0442\u0435
      \u043A\u043E\u043B\u0451\u0441\u0438\u043A\u043E \u043C\u044B\u0448\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C
      \u043E\u0431\u044A\u0435\u043A\u0442. \u0417\u0430\u0436\u043C\u0438\u0442\u0435
      \u043A\u043B\u0430\u0432\u0438\u0448\u0443 Shift, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0440\u043E\u0442."
    isShowed: 0
    showingTime: 7
  - key: Orders1
    title: "\u0417\u0430\u043A\u0430\u0437\u044B"
    value: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C, \u0432\u044B
      \u0432\u0437\u044F\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u0439 \u0437\u0430\u043A\u0430\u0437!
      \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u043D\u0430 \u043A\u0443\u0445\u043D\u044E
      (\u043D\u0430\u043B\u0435\u0432\u043E \u043E\u0442 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B).
      \u041D\u0430 \u043F\u0435\u0447\u043A\u0435 \u0432\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u0435
      \u0441\u043F\u0438\u0441\u043E\u043A \u0432\u0441\u0435\u0445 \u0442\u0435\u043A\u0443\u0449\u0438\u0445
      \u0437\u0430\u043A\u0430\u0437\u043E\u0432."
    isShowed: 0
    showingTime: 7
  - key: Orders2
    title: "\u0417\u0430\u043A\u0430\u0437\u044B 2"
    value: "\u041F\u043E\u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435
      \u0441 \u043F\u0435\u0447\u043A\u043E\u0439 \u0438  \u043A\u043E\u0442\u043B\u043E\u043C,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E
      \u043D\u0430 \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C.
      \u041D\u0430\u0432\u043E\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u0438\u043B\u0438
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B \u0432 \u0440\u0435\u0446\u0435\u043F\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435.
      \u041A\u0430\u043A \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435 -
      \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u043A \u041D\u041F\u0421,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044B\u0434\u0430\u043B \u0432\u0430\u043C
      \u0437\u0430\u043A\u0430\u0437 \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
      \u0441 \u043D\u0438\u043C, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0434\u0430\u0442\u044C
      \u0437\u0430\u043A\u0430\u0437 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
    isShowed: 0
    showingTime: 7
  - key: Orders3
    title: "\u0417\u0430\u043A\u0430\u0437\u044B 3"
    value: "\u041D\u0430 \u043F\u0435\u0447\u043A\u0435 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u043E\u0436\u0430\u0440\u0438\u0442\u044C \u0433\u0440\u0438\u0431\u044B.
      \u041D\u0430\u0439\u0442\u0438 \u0438\u0445 \u043C\u043E\u0436\u043D\u043E
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0435. \u0412 \u043A\u043E\u0442\u043B\u0435
      \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u0441\u0443\u043F, \u043D\u043E \u043E\u043D \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 1 \u0443\u0440\u043E\u0432\u043D\u0435
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438. \u041A\u0432\u0430\u0441
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u043B\u0438\u0442\u044C \u0438\u0437
      \u0431\u043E\u0447\u043A\u0438 \u043D\u0430 \u0441\u0442\u043E\u0439\u043A\u0435
      \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u043C \u0437\u0430\u043B\u0435,
      \u0442\u0430\u043C \u0436\u0435, \u0433\u0434\u0435 \u0441\u0442\u043E\u044F\u0442
      \u043A\u0440\u0443\u0436\u043A\u0438."
    isShowed: 0
    showingTime: 7
  - key: Orders4
    title: "\u0417\u0430\u043A\u0430\u0437\u044B 4"
    value: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C \u0441
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435\u043C \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0437\u0430\u043A\u0430\u0437\u0430! \u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439
      \u0433\u043E\u0441\u0442\u044C \u0443\u0445\u043E\u0434\u0438\u0442, \u0432\u0430\u043C
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u0443\u0434\u0430,
      \u0430 \u0442\u0430\u043A\u0436\u0435 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F
      \u0434\u0435\u043D\u044C\u0433\u0438 - \u0432\u0430\u043B\u043B\u0438\u0441,
      \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432\u044B \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442\u0435
      \u0441\u0432\u043E\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
    isShowed: 0
    showingTime: 7
  - key: DialogTutorial1
    title: "\u0414\u0438\u0430\u043B\u043E\u0433\u0438 1"
    value: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0443 \u0432\u0430\u0441 \u0437\u0430\u0432\u044F\u0437\u0430\u043B\u0441\u044F
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440. \u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C,
      \u0441 \u0441\u043E\u0446\u0438\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0435\u0439!\\n\u0412
      \u0438\u0433\u0440\u0435 \u0435\u0441\u0442\u044C 2 \u0440\u0435\u0436\u0438\u043C\u0430
      \u043E\u0431\u0449\u0435\u043D\u0438\u044F - \u0441\u043A\u0440\u0438\u043F\u0442\u043E\u0432\u044B\u0439
      \u0438 \u043D\u0435\u0439\u0440\u043E\u0441\u0435\u0442\u044C. \u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0440\u0435\u0436\u0438\u043C \u043C\u043E\u0436\u043D\u043E \u043F\u043E
      \u043A\u043D\u043E\u043F\u043A\u0435 \u0432 \u043F\u0440\u0430\u0432\u043E\u043C-\u0432\u0435\u0440\u0445\u043D\u0435\u043C
      \u0443\u0433\u043B\u0443 \u044D\u043A\u0440\u0430\u043D\u0430."
    isShowed: 1
    showingTime: 7
  - key: DialogTutorial2
    title: "\u0414\u0438\u0430\u043B\u043E\u0433\u0438 2"
    value: "\u0412 \u0441\u043A\u0440\u0438\u043F\u0442\u043E\u0432\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u0441\u044E\u0436\u0435\u0442\u043D\u044B\u0435 \u0440\u0435\u043F\u043B\u0438\u043A\u0438
      \u0438\u043B\u0438 \u0443\u0437\u043D\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043D\u043E\u0432\u043E\u0441\u0442\u0438 \u0443 \u043D\u043F\u0441, \u0447\u0442\u043E\u0431\u044B
      \u0431\u044B\u0442\u044C \u0432 \u043A\u0443\u0440\u0441\u0435 \u043C\u0438\u0440\u043E\u0432\u044B\u0445
      \u0441\u043E\u0431\u044B\u0442\u0438\u0439. \u041D\u043E \u0443\u0447\u0442\u0438\u0442\u0435,
      \u043D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u043D\u043F\u0441 \u0437\u043D\u0430\u0435\u0442
      \u0432\u0430\u0436\u043D\u0443\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E..."
    isShowed: 1
    showingTime: 7
  - key: DialogTutorial3
    title: "\u0414\u0438\u0430\u043B\u043E\u0433\u0438 3"
    value: "\u0412 \u0440\u0435\u0436\u0438\u043C\u0435 \u043D\u0435\u0439\u0440\u043E\u0441\u0435\u0442\u0438
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438 \u0441\u0430\u043C\u0438
      \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u044E\u0442 \u043E\u0442\u0432\u0435\u0442\u044B
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
      \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438
      \u0438 \u043C\u043E\u0433\u0443\u0442 \u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0439
      \u0434\u0438\u0430\u043B\u043E\u0433.\\n\u0423\u0447\u0442\u0438\u0442\u0435:
      \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442\u0435 \u0437\u0430\u043A\u0430\u0437
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F - \u0440\u0430\u0437\u043E\u0437\u043B\u0438\u0442\u0435
      \u043A\u043B\u0438\u0435\u043D\u0442\u0430. \u0423\u0434\u0430\u0447\u0438!"
