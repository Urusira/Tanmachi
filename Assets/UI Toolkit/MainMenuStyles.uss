:root {
}

.main-menu-button {
    width: auto;
    height: auto;
    font-size: 48px;
    -unity-font-definition: url("project://database/Packages/com.unity.collab-proxy/Editor/Assets/Fonts/Cascadia.ttf?fileID=12800000&guid=9229ae5dbc38f488d921156ff75869e9&type=3#Cascadia");
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    color: rgb(255, 255, 255);
    text-shadow: 4px 4px 8px rgb(0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(0, 0, 0);
    margin-bottom: 32px;
    transition-property: font-size, rotate;
    transition-timing-function: ease, ease;
    transition-duration: 250ms, 200ms;
    transition-delay: 0ms, 0ms;
}

.main-menu-button:hover {
    rotate: 1deg;
    transition-duration: 200ms;
    font-size: 52px;
}
